{
  "extraKnownMarketplaces": {
    "aws-claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/aws-solutions-library-samples/guidance-for-claude-code-with-amazon-bedrock.git"
      }
    }
  },
  "enabledPlugins": {
    "epcc-workflow@aws-claude-code-plugins": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-client.sh"
          }
        ]
      }
    ]
  }
}
